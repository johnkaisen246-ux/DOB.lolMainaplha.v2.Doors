local TrackedAlerts = {}
local function CheckEntityAlert(child)
    if not _G.EntityNotifier or not child or not child.Name then return end
    local nameL = child.Name:lower()
    
    if nameL:find("mesh") or nameL:find("cube") or nameL:find("fake") then return end
    if TrackedAlerts[child] then return end

    if nameL:find("eyes") then
        TrackedAlerts[child] = true
        Library:Notify("👁️ EYES PARTICLES COMING — DO NOT LOOK!")
        return
    end

    local dangerousEntities = {"rush", "ambush", "glitch", "a-60", "a-120", "screech", "dread"}
    for _, entityName in pairs(dangerousEntities) do
        if nameL:find(entityName) then
            TrackedAlerts[child] = true
            Library:Notify("⚠️ WARNING: " .. child.Name:upper() .. " IS COMING — HIDE!")
            break
        end
    end
end

Workspace.ChildAdded:Connect(CheckEntityAlert)
