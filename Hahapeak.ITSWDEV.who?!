            local targetSpeed = math.clamp(_G.SpeedValue, 16, 28)
            local diff = targetSpeed - 16
            if diff > 0 then
                local displacement = Humanoid.MoveDirection * (diff * dt * 0.9)
                RootPart.CFrame = RootPart.CFrame + displacement
            end
        end
    end
end)

